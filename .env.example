# Copy to .env.local and adjust. Only NEXT_PUBLIC_* values reach the browser,
# so this file must never contain secrets (DATABASE_URL, JWT_SECRET, service-role
# keys, OAuth client secrets, ...). Those belong to the FastAPI backend only.

# Base URL of the Scritto FastAPI backend, including the /api/v1 prefix.
#   Separate subdomain:  https://api.scritto.app/api/v1
#   Same domain/proxy:   /api/v1   (relative URLs are supported)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# "false" (default) talks to the real FastAPI backend at NEXT_PUBLIC_API_URL.
# "true" serves fake data from lib/mocks; only for UI work without a backend.
NEXT_PUBLIC_USE_MOCKS=false

# Optional sub-path when the admin is served under a path, e.g. /admin for
# scritto.app/admin. Leave empty when served at a domain root (admin.scritto.app).
NEXT_PUBLIC_BASE_PATH=

# Optional: "true" builds a self-contained server in .next/standalone (Docker/VPS).
NEXT_OUTPUT_STANDALONE=false
