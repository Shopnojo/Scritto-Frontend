# Public browser configuration only. Never put a service-role key or OAuth secret here.
# Supabase project already used by the Scritto Android app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Existing Express backend URL, including /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# "true" uses the UI mock data. Keep false for real backend auth and API calls.
NEXT_PUBLIC_USE_MOCKS=false

# Optional deployment sub-path; leave empty for localhost:3000.
NEXT_PUBLIC_BASE_PATH=

# Optional standalone build output for Docker/VPS.
NEXT_OUTPUT_STANDALONE=false
